{
  "manifest": {
    "id": "demo",
    "min_core_version": null,
    "name": "Demo",
    "version": "0.1.0",
    "plugin_api_version": "1",
    "entry": {
      "exe": "demo.exe",
      "args": [
        "--port",
        "{port}",
        "--data-dir",
        "{data_dir}",
        "--config-file",
        "{config_file}"
      ]
    },
    "preferred_port": 18611,
    "health_path": "/healthz",
    "capabilities_path": "/vf-plugin/v1/capabilities",
    "quota_path": "/vf-plugin/v1/quota",
    "config_schema": {
      "type": "object",
      "properties": {
        "video_model": {
          "type": "string",
          "default": "m1",
          "x-dynamic-enum": "capabilities.video.models[].id"
        }
      }
    },
    "actions": []
  },
  "responses": {
    "capabilities": {
      "plugin_api_version": "1",
      "kinds": ["video", "image"],
      "stale": false,
      "video": {
        "modes": ["i2v"],
        "models": [
          {
            "id": "m1",
            "label": "Demo video",
            "aspects": ["16:9"],
            "durations": [8]
          }
        ],
        "max_concurrent_jobs_per_account": 1,
        "poll_hint": {"interval_s": 15, "max_s": 1800},
        "supports_cancel": "before_submit_only"
      },
      "image": {
        "modes": ["i2i"],
        "models": [
          {
            "id": "i1",
            "label": "Demo image",
            "aspects": ["1:1"]
          }
        ]
      }
    },
    "quota": {
      "limits": [
        {
          "media_kind": "video",
          "unit": "credits",
          "accounts": [
            {
              "id": "default",
              "label": "A",
              "balance": 0,
              "total": 100,
              "reset_at": null,
              "status": "exhausted"
            }
          ],
          "total_balance": 0
        }
      ]
    },
    "video_post_replay_202": {"id": "t1", "task_id": "t1", "status": "processing"},
    "video_poll_200": {"status": "succeeded", "media_name": "clip.mp4"},
    "image_pending_202": {
      "operation_id": "123e4567-e89b-42d3-a456-426614174000",
      "media_kind": "image",
      "status": "processing"
    },
    "image_lookup_200": {
      "operation_id": "123e4567-e89b-42d3-a456-426614174000",
      "media_kind": "image",
      "status": "succeeded",
      "data": [
        {
          "b64_json": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAACklEQVR4nGNgAAAAAgABSK+kcQAAAABJRU5ErkJggg=="
        }
      ]
    },
    "cancel_before_post_200": {
      "operation_id": "123e4567-e89b-42d3-a456-426614174001",
      "status": "cancelled"
    },
    "cooldown": {
      "status": "failed",
      "error": {
        "kind": "transient",
        "code": "PROVIDER_RATE_LIMITED",
        "scope": "instance",
        "retryable": false,
        "retry_after_s": 1800,
        "message": "Tạm dừng nhận việc trên instance này."
      }
    }
  }
}
